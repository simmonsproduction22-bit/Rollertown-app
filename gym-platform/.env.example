# ---------------------------------------------------------------------------
# [ProductName] environment. Copy to .env.local and fill in. Never commit keys.
# With no Supabase/Stripe keys set, the app runs in DEMO MODE with seeded,
# in-memory data so every screen works out of the box.
# ---------------------------------------------------------------------------

# Public app URL (used for links in emails/SMS, Stripe redirects, QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Force demo mode even when keys are present ("true" / "false")
DEMO_MODE=

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the seed script, webhooks and the public API.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe Connect (test mode keys: sk_test_..., pk_test_...) --------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform transaction fee in basis points (300 = 3.00%). Shown at checkout.
PLATFORM_FEE_BPS=300

# --- SMS (Twilio-compatible). Empty = log to console -------------------------
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (Resend-compatible HTTP API). Empty = log to console --------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Demo MMA Academy <no-reply@example.com>"

# --- Public API / webhooks ----------------------------------------------------
# Secret used to sign outgoing webhook payloads (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=

# Protects /api/cron (send reminders, automations, payment retries). Call every 15 min.
CRON_SECRET=
